{
  "version": "1.6",
  "status": "production-ready",
  "owner": "Andrey Li",
  "source_of_truth": "core/master-doc.md",
  "canonical_routing_source": "source-registry.json",
  "routing_policy": {
    "first_step": "Read source-registry.json before free-text search.",
    "search_is": "fallback",
    "known_sources": "Use exact paths from source-registry.json and linked method-source-registry.json first."
  },
  "architecture": {
    "github": "knowledge_base",
    "chatgpt_project": "runtime",
    "source_registry": "source-registry.json",
    "method_registry": "andylitvinov-design/alchemy-method/method-source-registry.json",
    "method_source": "andylitvinov-design/alchemy-method",
    "business_source": "andrey-system",
    "report_agent_instruction_source": "project-ready/report-agent-project-instruction.md",
