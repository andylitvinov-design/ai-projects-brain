    "report_templates_source": "core/report-template.md",
    "structural_report_examples_source": "examples/",
    "method_report_index_source": "andylitvinov-design/alchemy-method/consultations/reports-index.md",
    "method_report_logic_source": "andylitvinov-design/alchemy-method/consultations/report-logic.md",
    "live_ru_report_example": "andylitvinov-design/alchemy-method/consultations/examples/confidence-bach-report-example.md"
  },
  "entry_points": {
    "machine": "source-registry.json",
    "agent": "AGENT-START-HERE.md",
    "human": "README.md"
  },
  "agents": {
    "business_builder": {
      "instruction": "agent/business-builder-instructions.md",
      "playbook": "agent/business-builder-playbook.md",
      "project_ready": "project-ready/business-builder-project-instruction.md"
    },
    "report_agent": {
      "role": "multi-format client reporting agent",
      "instruction": "agent/report-agent-instructions.md",
      "playbook": "agent/report-agent-playbook.md",
      "project_ready": "project-ready/report-agent-project-instruction.md",
      "writing_instructions": "core/report-template.md",
      "templates": "core/report-template.md",
      "structural_examples": "examples/",
      "method_registry": "andylitvinov-design/alchemy-method/method-source-registry.json",
      "method_report_index": "andylitvinov-design/alchemy-method/consultations/reports-index.md",
      "live_ru_report_example": "andylitvinov-design/alchemy-method/consultations/examples/confidence-bach-report-example.md",
      "formats": [
        "express_diagnosis",
        "full_client_report",
        "monthly_progress_report",
        "remedy_support_note",
        "homeopathy_situation_decoder"
      ]
    }
  },
  "project_ready": [
    "project-ready/business-builder-project-instruction.md",
    "project-ready/report-agent-project-instruction.md"
  ],
  "core_files": [
    "core/master-doc.md",
    "core/product-structure.md",
    "core/content-formulas.md",
    "core/report-template.md",
    "core/quality-checklist.md"
  ],
  "report_architecture": {
    "layer_0_source_registry": {
      "file": "source-registry.json",
      "purpose": "canonical machine-readable routing before search"
    },
    "layer_0_method_registry": {
      "file": "andylitvinov-design/alchemy-method/method-source-registry.json",
      "purpose": "canonical method/report source registry"
    },
    "layer_1_agent_instruction": {
      "file": "project-ready/report-agent-project-instruction.md",
      "purpose": "who the agent is, which report type to choose, and what to do in each case"
    },
    "layer_2_report_writing_instructions": {
      "file": "core/report-template.md",
      "purpose": "what to check before writing each report and how to write it"
    },
    "layer_3_structural_report_examples": {
      "directory": "examples/",
      "purpose": "structural sample reports for report formats; English samples are not the primary Russian client style source"
    },
    "layer_4_live_ru_report_examples": {
      "index": "andylitvinov-design/alchemy-method/consultations/reports-index.md",
      "primary_example": "andylitvinov-design/alchemy-method/consultations/examples/confidence-bach-report-example.md",
      "purpose": "primary Russian client-facing tone and live report style"
    },
    "workflow_playbook": "agent/report-agent-playbook.md",
    "method_logic": "andylitvinov-design/alchemy-method/consultations/report-logic.md",
    "dao_scale": "andylitvinov-design/alchemy-method/method/dao-resource-scale.md"
  },
  "agent_files": [
    "agent/agent-map.md",
    "agent/business-builder-instructions.md",
    "agent/business-builder-playbook.md",
    "agent/report-agent-instructions.md",
    "agent/report-agent-playbook.md"
  ],
  "examples": [
    "examples/sample-express-diagnosis.md",
    "examples/sample-full-client-report.md",
    "examples/sample-monthly-progress-report.md",
    "examples/sample-remedy-support-note.md",
    "examples/sample-homeopathy-decoder.md",
    "examples/sample-business-offer.md",
    "examples/sample-post.md"
  ],
  "method_examples": [
    "andylitvinov-design/alchemy-method/consultations/examples/confidence-bach-report-example.md"
  ],
  "known_answer_map": {
    "real_russian_client_report": "andylitvinov-design/alchemy-method/consultations/examples/confidence-bach-report-example.md",
    "report_index": "andylitvinov-design/alchemy-method/consultations/reports-index.md",
    "method_registry": "andylitvinov-design/alchemy-method/method-source-registry.json"
  },
  "reading_order": [
    "source-registry.json",
    "system-index.json",
    "AGENT-START-HERE.md",
    "core/master-doc.md",
    "agent/agent-map.md",
    "agent/{selected-agent}-instructions.md",
    "agent/{selected-agent}-playbook.md",
    "core/{task-file}.md",
    "alchemy-method/method-source-registry.json, if the task is about method or reports",
    "alchemy-method/consultations/reports-index.md, if the task is about client reports",
    "alchemy-method/consultations/examples/confidence-bach-report-example.md, if the output is a Russian client report",
    "examples/{relevant-example}.md"
  ]
}
